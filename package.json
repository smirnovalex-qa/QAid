{
  "name": "qaid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "QAid — local-first Manifest V3 extension with a consolidated set of QA tools.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-content.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "package": "pnpm build && node scripts/package.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "check-version": "node scripts/check-version.mjs",
    "release-notes": "node scripts/release-notes.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@preact/signals": "^1.3.1",
    "preact": "^10.24.3",
    "webextension-polyfill": "^0.12.0",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@crxjs/vite-plugin": "2.0.0-beta.33",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@preact/preset-vite": "^2.9.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.0.287",
    "@types/node": "^20.17.6",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitest/coverage-v8": "^2.1.5",
    "@vitest/ui": "^2.1.5",
    "archiver": "^7.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "playwright": "^1.48.2",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "vitest-axe": "^0.1.0"
  }
}
